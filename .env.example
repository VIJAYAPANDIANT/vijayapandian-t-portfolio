# Environment Variables Template
# Copy this file to .env or .env.local to configure custom environment settings.
# NEVER commit your actual .env file or real secrets to Git.

# Example for future email or form services (e.g. EmailJS / Formspree)
# VITE_EMAILJS_SERVICE_ID=your_service_id_here
# VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
# VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Example site URL
VITE_SITE_URL=https://vijayapandian-t-portfolio.vercel.app
